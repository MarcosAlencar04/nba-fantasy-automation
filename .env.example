# Copie este arquivo para ".env" (com o ponto, sem o ".txt")
# Necessario para o agente (ESPN) e para as notificacoes

# ---------------------------------------------------------------------------
# FONTE DA LISTA DE USUARIOS
#
# Com DATABASE_URL definida, o banco e' a fonte: ESPN_TEAM_ID / EMAIL_TO /
# TELEGRAM_CHAT_ID sao ignorados (as credenciais do ESPN vem da tabela
# `leagues`). Sem ela, vale o modo legado das listas posicionais abaixo.
#
# A forma recomendada de rodar localmente com banco:
#   DATABASE_URL='postgresql://...' python3 teams.py matrix
#   DATABASE_URL='postgresql://...' python3 teams.py resolve 0
# ---------------------------------------------------------------------------
DATABASE_URL=

# Nome que aparece na saudacao do email ("Oi, Fulano!"). No modo banco e'
# preenchido pelo workflow a partir do cadastro; aqui serve para testes locais.
USER_NAME=

# ----------------------------------------------------------------------
# PAINEL (panel/app.py) — nao usado pelo agente
#
# PANEL_USER/PANEL_PASSWORD: HTTP Basic Auth de todas as paginas do painel.
# SUGGESTION_KEY: chave do formulario PUBLICO de sugestoes (/sugestoes). Quem
# recebe o link nao precisa de login: a chave no `?k=` autoriza o envio.
#   - minimo de 16 caracteres; chave curta = formulario desativado
#   - vazia = formulario desativado (503), nada fica aberto
#   - gere com: python3 -c "import secrets;print(secrets.token_urlsafe(24))"
# Link para enviar ao cliente:
#   https://SEU-PAINEL.vercel.app/sugestoes?k=SUA_CHAVE
# ----------------------------------------------------------------------
PANEL_USER=
PANEL_PASSWORD=
SUGGESTION_KEY=

# ---------------------------------------------------------------------------
# MODO LEGADO (usado somente quando DATABASE_URL esta vazia)
#
# Varios times: listas separadas por virgula, SEMPRE na mesma ordem.
# A posicao N de ESPN_TEAM_ID recebe no destinatario da posicao N.
#   ESPN_TEAM_ID=7,9,11
#   EMAIL_TO=marcos@x.com,amigo@y.com,outro@z.com
#   TELEGRAM_CHAT_ID=123456789,XXX,987654321   <- XXX = nao configurado
# Virgula final, espacos e quebra de linha sao tolerados.
# Rodando local, so a primeira posicao de ESPN_TEAM_ID e usada.
#
# As tres credenciais do ESPN abaixo valem para a liga inteira neste modo. Com
# DATABASE_URL definida elas sao ignoradas: cada usuario usa as credenciais da
# propria liga, cadastradas no painel (tabela `leagues`).
# ---------------------------------------------------------------------------
ESPN_LEAGUE_ID=
ESPN_TEAM_ID=
ESPN_SWID={XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX}
ESPN_S2=

# Chat id numerico (grupos usam negativo). "XXX" ou vazio = nao envia.
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Email (SMTP).
# Na nuvem, EMAIL_TO e posicional (uma entrada por time).
# Localmente, ',' e ';' separam destinatarios do mesmo time.
# Gmail: smtp.gmail.com:587 + app password (nao use a senha da conta)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
EMAIL_FROM_NAME=NBA Fantasy
EMAIL_TO=

# Agendador (scheduler.py). Horario no fuso da sua maquina.
MORNING_TIME=10:00
PREGAME_LEAD_MIN=30
