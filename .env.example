# Copie este arquivo para ".env" (com o ponto, sem o ".txt")
# Necessario somente para --espn, --telegram e --email

ESPN_LEAGUE_ID=
ESPN_SWID={XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX}
ESPN_S2=

TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Email (SMTP). Destinatarios separados por virgula.
# Gmail: smtp.gmail.com:587 + app password (nao use a senha da conta)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
EMAIL_TO=