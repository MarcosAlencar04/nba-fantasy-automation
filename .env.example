# Copie este arquivo para ".env" (com o ponto, sem o ".txt")
# Necessario para o agente (ESPN) e para as notificacoes

# Vários times: use listas separadas por virgula, SEMPRE na mesma ordem.
# A posicao N de ESPN_TEAM_ID recebe no destinatario da posicao N.
#   ESPN_TEAM_ID=7,9
#   EMAIL_TO=marcos@x.com,amigo@y.com
#   TELEGRAM_CHAT_ID=123456789,XXX   <- XXX = nao configurado
# Rodando local, so a primeira posicao de ESPN_TEAM_ID e usada.
ESPN_LEAGUE_ID=
ESPN_TEAM_ID=
ESPN_SWID={XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX}
ESPN_S2=

# Chat id numerico (grupos usam negativo). "XXX" ou vazio = nao envia.
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Email (SMTP).
# Na nuvem, EMAIL_TO e posicional (uma entrada por time).
# Localmente, ',' e ';' separam destinatarios do mesmo time.
# Gmail: smtp.gmail.com:587 + app password (nao use a senha da conta)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
EMAIL_FROM_NAME=NBA Fantasy
EMAIL_TO=

# Agendador (scheduler.py). Horario no fuso da sua maquina.
MORNING_TIME=10:00
PREGAME_LEAD_MIN=30
